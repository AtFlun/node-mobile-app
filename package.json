{
  "name": "@flun/node-mobile-app",
  "version": "4.3.0",
  "description": "将 Node.js 项目一键打包为 Android / iOS 移动应用,运行时由 @flun/nodejs-mobile-react-native 提供;",
  "author": "flun <open@flun.top>",
  "keywords": [
    "node-mobile",
    "nodejs",
    "nodejs-mobile",
    "react-native",
    "android",
    "ios",
    "mobile",
    "mobile-app",
    "apk",
    "ipa",
    "express",
    "webview",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "cli-assets/",
    "scripts/",
    "src/",
    "template/",
    "自定义libnode指南.md",
    "Android构建指南.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "mobileAppConfig.js"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-files.js"
  },
  "dependencies": {
    "@babel/core": "^8.1.2",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@flun/nodejs-mobile-react-native": "^2.2.0",
    "@react-native-community/cli": "^21.0.0",
    "@react-native-community/cli-platform-android": "^21.0.0",
    "@react-native-community/cli-platform-ios": "^21.0.0",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/metro-config": "^0.88.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-webview": "^14.0.1",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "node": true,
    "@flun/nodejs-mobile-react-native": true,
    "@parcel/watcher": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "homepage": "https://github.com/OpenFlun/node-mobile-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/node-mobile-app.git"
  },
  "gitee": {
    "type": "git",
    "url": "https://gitee.com/OpenFlun/node-mobile-app.git"
  },
  "bugs": {
    "url": "https://github.com/OpenFlun/node-mobile-app/issues"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "node-mobile-app": "./bin/cli.js"
  }
}